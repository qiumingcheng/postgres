\pset format unaligned
\pset tuples_only on
SET client_min_messages=warning;
CREATE TABLE ggc_cbo_vertex(id bigint PRIMARY KEY);
CREATE TABLE ggc_cbo_edge(
 id bigint PRIMARY KEY,
 src bigint NOT NULL,
 dst bigint NOT NULL,
 weight bigint NOT NULL
) WITH(fillfactor=40);
INSERT INTO ggc_cbo_vertex SELECT i FROM generate_series(1,8) i;
INSERT INTO ggc_cbo_edge VALUES
 (101,1,2,5),(102,1,3,5),(103,2,4,5),(104,3,4,5),
 (105,4,1,5),(106,4,5,50),(107,5,6,5),(108,6,7,5),
 (109,1,2,5);
CREATE INDEX ggc_cbo_edge_out ON ggc_cbo_edge(src);
CREATE PROPERTY GRAPH ggc_cbo_graph
 VERTEX TABLES(ggc_cbo_vertex KEY(id))
 EDGE TABLES(ggc_cbo_edge KEY(id)
  SOURCE KEY(src) REFERENCES ggc_cbo_vertex(id)
  DESTINATION KEY(dst) REFERENCES ggc_cbo_vertex(id));
CREATE TABLE ggc_cbo_request(anchor bigint NOT NULL);
INSERT INTO ggc_cbo_request VALUES (1),(2);
CREATE TABLE ggc_cbo_dimension(id bigint PRIMARY KEY,name text NOT NULL);
INSERT INTO ggc_cbo_dimension VALUES (1,'one'),(4,'four');
ANALYZE ggc_cbo_request;
ANALYZE ggc_cbo_edge;
ANALYZE ggc_cbo_dimension;
CREATE TEMP TABLE ggc_cbo_state AS
WITH ids AS
(
 SELECT 'ggc_cbo_graph'::regclass::oid::bigint graph_oid,
        'ggc_cbo_edge_out'::regclass::oid::bigint index_oid,
        (SELECT oid::bigint FROM pg_roles WHERE rolname=current_user) role_oid
), mapped AS
(
 SELECT ids.*,p.oid::bigint edge_oid
 FROM ids JOIN pg_propgraph_element p
   ON p.pgepgid=ids.graph_oid AND p.pgekind='e'
), scopes AS
(
 SELECT *,jsonb_build_object(
   'catalog_provider_oid',0,'graph_oid',graph_oid,'edge_element_oid',edge_oid,
   'index_relid',0,'effective_role',role_oid,'endpoint_domain',77,
   'scope_kind',1,'direction',1,'path_mode',1,'result_mode',1,
   'catalog_generation',7,'security_generation',11,'build_generation',0,
   'semantic_fingerprint',54321) logical_scope,
  jsonb_build_object(
   'catalog_provider_oid',0,'graph_oid',graph_oid,'edge_element_oid',edge_oid,
   'index_relid',index_oid,'effective_role',role_oid,'endpoint_domain',77,
   'scope_kind',2,'direction',1,'path_mode',1,'result_mode',1,
   'catalog_generation',7,'security_generation',11,'build_generation',1,
   'semantic_fingerprint',54321) physical_scope,
  jsonb_build_object(
   'catalog_provider_oid',0,'graph_oid',0,'edge_element_oid',0,
   'index_relid',0,'effective_role',role_oid,'endpoint_domain',0,
   'scope_kind',3,'direction',0,'path_mode',0,'result_mode',0,
   'catalog_generation',0,'security_generation',0,'build_generation',0,
   'semantic_fingerprint',1) cost_scope
 FROM mapped
), configured AS
(
 SELECT *,jsonb_build_object(
   'seed',20260921,'seed_target',8,'hops',2,
   'predicate_attnum',4,'predicate_min',1,'predicate_max',100,
   'predicate_clause_id',1,'max_scan_pages',1000,
   'max_examined_entries',100000,'max_bindings',10000,
   'max_bindings_per_seed',5000,'max_entries_per_seed',5000,
   'max_memory_bytes',67108864,'max_payload_bytes',1048576,
   'max_profiles',64,'max_parent_batch',8,'deadline_ms',10000,
   'lock_timeout_ms',1000) options
 FROM scopes
)
SELECT graph_oid,edge_oid,index_oid,logical_scope,physical_scope,cost_scope,options,
       pg_graph_statistic_create(logical_scope,'{}'::jsonb) logical_oid,
       pg_graph_statistic_create(physical_scope,'{}'::jsonb) physical_oid,
       coalesce((SELECT oid FROM pg_graph_statistic
                 WHERE gstkind=3 AND gstowner=role_oid
                 ORDER BY oid DESC LIMIT 1),
                pg_graph_statistic_create(cost_scope,'{}'::jsonb)) cost_oid
FROM configured;
SELECT (pg_graph_statistic_collect_path(logical_oid,physical_oid,options)->>'status')='READY'
FROM ggc_cbo_state;
t
CREATE FUNCTION pg_temp.ggc_publish_cost(p_value float8)
RETURNS bigint LANGUAGE SQL AS $$
WITH constants AS
(
 SELECT jsonb_build_object(
  'started_at','2026-09-21 00:00:00+00','finished_at','2026-09-21 00:00:01+00',
  'snapshot_source','native_cbo_regression','sample_method','fixed_test_profile',
  'truncation_reason','none','seed',50001,'population',7,'sample_count',100,
  'effective_sample_size',100,'complete_depth',0,'layout_version',1,
  'model_version',1,'change_baseline',jsonb_build_object('source','G1-050'),
  'resources',jsonb_build_object('scan_pages',0,'examined_entries',700,
                                 'peak_bytes',65536)) metadata
), coefficients(metric_kind,component) AS
(
 VALUES (300,'batch_startup'),(301,'key_probe'),(302,'ref_deref'),
        (303,'adj_item'),(304,'heap_fetch'),(305,'heap_page_group'),
        (306,'binding_extend')
), payload AS
(
 SELECT jsonb_agg(jsonb_build_object(
  'metric_kind',metric_kind,
  'profile_key',jsonb_build_object('cost_profile_version',1,'component',component),
  'metadata',metadata,
  'estimate',jsonb_build_object('kind',1,'state',1,'sample_count',100,
    'p95_known',false,'uncertainty_known',false,'censored',false,
    'expected',p_value,'workload_p95',NULL,'uncertainty_low',NULL,
    'uncertainty_high',NULL))) profiles
 FROM coefficients CROSS JOIN constants
)
SELECT pg_graph_statistic_publish(cost_oid,profiles)
FROM ggc_cbo_state,payload
$$;
CREATE FUNCTION pg_temp.ggc_plan(p_query text)
RETURNS jsonb LANGUAGE plpgsql AS $$
DECLARE result jsonb;
BEGIN
 EXECUTE 'EXPLAIN (FORMAT JSON, COSTS OFF) ' || p_query INTO result;
 RETURN result;
END
$$;
SELECT pg_temp.ggc_publish_cost(0.000001)>0;
t
SELECT test_graph_cbo_config(
 'ggc_cbo_request','ggc_cbo_edge','ggc_cbo_edge_out',
 graph_oid::oid,edge_oid::oid,77,7,11,1,54321,2,1)
FROM ggc_cbo_state;
2
WITH plan AS
(
 SELECT pg_temp.ggc_plan($q$
  SELECT r.anchor,e1.id,e1.dst,e2.id,e2.dst
  FROM ggc_cbo_request r
  JOIN ggc_cbo_edge e1 ON e1.src=r.anchor
  JOIN ggc_cbo_edge e2 ON e2.src=e1.dst$q$) document
), graph_node AS
(
 SELECT jsonb_path_query_first(document,
  '$.** ? (@."Custom Plan Provider" == "GraphExpandFixed")') node
 FROM plan
)
SELECT node IS NOT NULL
   AND node->>'Graph Statistics' LIKE 'logical=READY generation=%physical=READY generation=%cost=READY'
   AND node->>'Graph Confidence'='unknown'
   AND node->>'Graph Cost Profile' LIKE 'calibrated v1 generation %'
   AND (node->>'Graph Covered Relids')::int=3
   AND (node->>'Graph Consumed Quals')::int=2
   AND (node->>'Graph Required Outer')::int=0
FROM graph_node;
t
WITH diagnostic AS (SELECT test_graph_cbo_diagnostic()::jsonb j)
SELECT (j->>'chain_matches')::int>0
   AND (j->>'contract_accepts')::int>0
   AND (j->>'paths_retained')::int>0
   AND (j->>'available_quals')::int=2
   AND (j->>'consumed_quals')::int=2
   AND j->>'reject_reason'='accepted'
FROM diagnostic;
t
SELECT count(*)=5 AND sum(r.anchor)=7 AND sum(e1.id)=518 AND sum(e2.id)=521
FROM ggc_cbo_request r
JOIN ggc_cbo_edge e1 ON e1.src=r.anchor
JOIN ggc_cbo_edge e2 ON e2.src=e1.dst;
t
SELECT pg_temp.ggc_publish_cost(10000)>0;
t
WITH plan AS
(
 SELECT pg_temp.ggc_plan($q$
  SELECT r.anchor,e1.id,e1.dst,e2.id,e2.dst
  FROM ggc_cbo_request r
  JOIN ggc_cbo_edge e1 ON e1.src=r.anchor
  JOIN ggc_cbo_edge e2 ON e2.src=e1.dst$q$) document
)
SELECT NOT jsonb_path_exists(document,
 '$.** ? (@."Custom Plan Provider" == "GraphExpandFixed")')
FROM plan;
t
SELECT count(*)=5 AND sum(r.anchor)=7 AND sum(e1.id)=518 AND sum(e2.id)=521
FROM ggc_cbo_request r
JOIN ggc_cbo_edge e1 ON e1.src=r.anchor
JOIN ggc_cbo_edge e2 ON e2.src=e1.dst;
t
SELECT pg_temp.ggc_publish_cost(0.000001)>0;
t
SELECT test_graph_cbo_config(
 'ggc_cbo_request','ggc_cbo_edge','ggc_cbo_edge_out',
 graph_oid::oid,edge_oid::oid,77,7,11,2,54321,2,1)
FROM ggc_cbo_state;
2
WITH plan AS
(
 SELECT pg_temp.ggc_plan($q$
  SELECT r.anchor,e1.id,e1.dst,e2.id,e2.dst
  FROM ggc_cbo_request r
  JOIN ggc_cbo_edge e1 ON e1.src=r.anchor
  JOIN ggc_cbo_edge e2 ON e2.src=e1.dst$q$) document
), graph_node AS
(
 SELECT jsonb_path_query_first(document,
  '$.** ? (@."Custom Plan Provider" == "GraphExpandFixed")') node
 FROM plan
)
SELECT node IS NOT NULL
   AND node->>'Graph Confidence'='unknown'
   AND node->>'Graph Statistics' LIKE '%physical=MISSING generation=0%'
FROM graph_node;
t
SELECT test_graph_cbo_config(
 'ggc_cbo_request','ggc_cbo_edge','ggc_cbo_edge_out',
 graph_oid::oid,edge_oid::oid,77,7,11,1,54321,2,1)
FROM ggc_cbo_state;
2
WITH plan AS
(
 SELECT pg_temp.ggc_plan($q$
  SELECT g.anchor,g.e1id,g.e2id,g.e2dst,d.name
  FROM
  (SELECT r.anchor,e1.id e1id,e2.id e2id,e2.dst e2dst
   FROM ggc_cbo_request r
   JOIN ggc_cbo_edge e1 ON e1.src=r.anchor
   JOIN ggc_cbo_edge e2 ON e2.src=e1.dst
   OFFSET 0) g
  LEFT JOIN ggc_cbo_dimension d ON d.id=g.e2dst$q$) document
)
SELECT jsonb_path_exists(document,
 '$.** ? (@."Custom Plan Provider" == "GraphExpandFixed")')
FROM plan;
t
WITH diagnostic AS (SELECT test_graph_cbo_diagnostic()::jsonb j)
SELECT (j->>'contract_accepts')::int>0
   AND (j->>'paths_retained')::int>0
FROM diagnostic;
t
SELECT count(*)=5 AND count(d.name)=4
FROM
(SELECT r.anchor,e1.id e1id,e2.id e2id,e2.dst e2dst
 FROM ggc_cbo_request r
 JOIN ggc_cbo_edge e1 ON e1.src=r.anchor
 JOIN ggc_cbo_edge e2 ON e2.src=e1.dst
 OFFSET 0) g
LEFT JOIN ggc_cbo_dimension d ON d.id=g.e2dst;
t
CREATE TABLE ggc_cbo_seed(id bigint PRIMARY KEY);
INSERT INTO ggc_cbo_seed VALUES (1),(2);
WITH plan AS
(
 SELECT pg_temp.ggc_plan($q$
  SELECT s.id,e1.id,e2.id
  FROM ggc_cbo_seed s
  CROSS JOIN LATERAL
  (SELECT r.anchor FROM ggc_cbo_request r
   WHERE r.anchor=s.id OFFSET 0) r
  JOIN ggc_cbo_edge e1 ON e1.src=r.anchor
  JOIN ggc_cbo_edge e2 ON e2.src=e1.dst$q$) document
), graph_node AS
(
 SELECT jsonb_path_query_first(document,
  '$.** ? (@."Custom Plan Provider" == "GraphExpandFixed")') node
 FROM plan
)
SELECT node IS NOT NULL AND (node->>'Graph Required Outer')::int=1
FROM graph_node;
t
SELECT pg_graph_statistic_drop(logical_oid) IS NOT NULL,
       pg_graph_statistic_drop(physical_oid) IS NOT NULL
FROM ggc_cbo_state;
t|t
DROP PROPERTY GRAPH ggc_cbo_graph;
DROP TABLE ggc_cbo_seed;
DROP TABLE ggc_cbo_dimension;
DROP TABLE ggc_cbo_request;
DROP TABLE ggc_cbo_edge;
DROP TABLE ggc_cbo_vertex;
