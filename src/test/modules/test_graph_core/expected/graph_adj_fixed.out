\pset format unaligned
\pset tuples_only on
CREATE TABLE ggc_solo_edge(
 id bigint PRIMARY KEY,
 src bigint NOT NULL,
 dst bigint NOT NULL,
 payload text
) WITH (fillfactor=40);
CREATE INDEX ggc_solo_out ON ggc_solo_edge USING graph_adj(src,dst);
