\pset format unaligned
\pset tuples_only on
SET client_min_messages=warning;
CREATE TABLE ggc_path_vertex(id bigint PRIMARY KEY);
CREATE TABLE ggc_path_edge(
 id bigint PRIMARY KEY,src bigint NOT NULL,dst bigint NOT NULL,
 weight bigint,payload text) WITH(fillfactor=40);
INSERT INTO ggc_path_vertex SELECT i FROM generate_series(1,8) i;
INSERT INTO ggc_path_edge VALUES
 (101,1,2,5,'a'),(102,1,3,5,'b'),(103,2,4,5,'c'),
 (104,3,4,5,'d'),(105,4,1,5,'cycle'),(106,4,5,50,'reject'),
 (107,5,6,5,'e'),(108,6,7,5,'f'),(109,1,2,5,'parallel');
CREATE INDEX ggc_path_edge_out ON ggc_path_edge(src);
CREATE PROPERTY GRAPH ggc_path_graph
 VERTEX TABLES(ggc_path_vertex KEY(id))
 EDGE TABLES(ggc_path_edge KEY(id)
  SOURCE KEY(src) REFERENCES ggc_path_vertex(id)
  DESTINATION KEY(dst) REFERENCES ggc_path_vertex(id));
CREATE TEMP TABLE ggc_path_state AS
WITH ids AS
(
 SELECT 'ggc_path_graph'::regclass::oid::bigint graph_oid,
        'ggc_path_edge_out'::regclass::oid::bigint index_oid,
        (SELECT oid::bigint FROM pg_roles WHERE rolname=current_user) role_oid
), mapped AS
(
 SELECT ids.*,p.oid::bigint edge_oid
 FROM ids JOIN pg_propgraph_element p
   ON p.pgepgid=ids.graph_oid AND p.pgekind='e'
), scopes AS
(
 SELECT jsonb_build_object(
   'catalog_provider_oid',0,'graph_oid',graph_oid,'edge_element_oid',edge_oid,
   'index_relid',0,'effective_role',role_oid,'endpoint_domain',77,
   'scope_kind',1,'direction',1,'path_mode',1,'result_mode',1,
   'catalog_generation',7,'security_generation',11,'build_generation',0,
   'semantic_fingerprint',98765) logical_scope,
  jsonb_build_object(
   'catalog_provider_oid',0,'graph_oid',graph_oid,'edge_element_oid',edge_oid,
   'index_relid',index_oid,'effective_role',role_oid,'endpoint_domain',77,
   'scope_kind',2,'direction',1,'path_mode',1,'result_mode',1,
   'catalog_generation',7,'security_generation',11,'build_generation',1,
   'semantic_fingerprint',98765) physical_scope
 FROM mapped
), configured AS
(
 SELECT *,jsonb_build_object(
   'seed',20260921,'seed_target',8,'hops',4,
   'predicate_attnum',4,'predicate_min',1,'predicate_max',10,
   'predicate_clause_id',1,'max_scan_pages',1000,
   'max_examined_entries',100000,'max_bindings',10000,
   'max_bindings_per_seed',5000,'max_entries_per_seed',5000,
   'max_memory_bytes',67108864,'max_payload_bytes',1048576,
   'max_profiles',64,'max_parent_batch',8,'deadline_ms',10000,
   'lock_timeout_ms',1000) options
 FROM scopes
)
SELECT logical_scope,physical_scope,options,
       pg_graph_statistic_create(logical_scope,'{}'::jsonb) logical_oid,
       pg_graph_statistic_create(physical_scope,'{}'::jsonb) physical_oid
FROM configured;
SELECT (r->>'status')='READY' AND (r->>'published')::boolean
       AND (r->>'complete_depth')::integer=4
       AND jsonb_array_length(r->'stages')=4
       AND (r->'stages'->0->>'N')::integer=8
       AND (r->'stages'->0->>'zero_degree_requests')::integer=2
FROM ggc_path_state s,
LATERAL (SELECT pg_graph_statistic_collect_path(
 s.logical_oid,s.physical_oid,s.options) r) q;
t
WITH document AS
(
 SELECT pg_graph_statistic_read(logical_oid,logical_scope) d
 FROM ggc_path_state
), profiles AS
(
 SELECT p FROM document,jsonb_array_elements(d->'profiles') p
)
SELECT count(*)=44
   AND count(*) FILTER (WHERE (p->>'metric_kind')::integer=209)=8
   AND bool_and(jsonb_array_length(p->'profile_key'->'F')=4
                AND jsonb_array_length(p->'profile_key'->'B')=4
                AND jsonb_array_length(p->'profile_key'->'E')=4
                AND jsonb_array_length(p->'profile_key'->'A')=4
                AND jsonb_array_length(p->'profile_key'->'P')=4)
       FILTER (WHERE (p->>'metric_kind')::integer=209)
   AND max((p->'estimate'->>'expected')::numeric)
       FILTER (WHERE (p->>'metric_kind')::integer=208
               AND (p->'profile_key'->>'stage')::integer=1)=1.5
FROM profiles;
t
WITH document AS
(
 SELECT pg_graph_statistic_read(physical_oid,physical_scope) d
 FROM ggc_path_state
), profiles AS
(
 SELECT p FROM document,jsonb_array_elements(d->'profiles') p
)
SELECT count(*)=24
   AND max((p->'estimate'->>'expected')::integer)
       FILTER (WHERE (p->>'metric_kind')::integer=220
               AND (p->'profile_key'->>'stage')::integer=1)=9
   AND max((p->'estimate'->>'expected')::integer)
       FILTER (WHERE (p->>'metric_kind')::integer=221
               AND (p->'profile_key'->>'stage')::integer=1)=9
   AND max((p->'estimate'->>'expected')::integer)
       FILTER (WHERE (p->>'metric_kind')::integer=222
               AND (p->'profile_key'->>'stage')::integer=1)=1
   AND max((p->'estimate'->>'expected')::integer)
       FILTER (WHERE (p->>'metric_kind')::integer=224
               AND (p->'profile_key'->>'stage')::integer=1)=2
FROM profiles;
t
SELECT (r->>'status')='PARTIAL' AND (r->>'published')::boolean
       AND (r->>'complete_depth')::integer=3
       AND r->>'reason'='max_bindings_per_seed'
       AND (r->'stages'->3->>'partial')::boolean
FROM ggc_path_state s,
LATERAL (SELECT pg_graph_statistic_collect_path(
 s.logical_oid,s.physical_oid,
 s.options||'{"max_bindings_per_seed":3}'::jsonb) r) q;
t
WITH document AS
(
 SELECT pg_graph_statistic_read(logical_oid,logical_scope) d
 FROM ggc_path_state
), profiles AS
(
 SELECT p FROM document,jsonb_array_elements(d->'profiles') p
 WHERE (p->'profile_key'->>'stage')::integer=4
   AND (p->>'metric_kind')::integer IN (203,204,205,207,208)
)
SELECT count(*)=5 AND bool_and(
 (p->'estimate'->>'kind')::integer=2
 AND (p->'estimate'->>'state')::integer=2
 AND (p->'estimate'->>'censored')::boolean
 AND (p->'metadata'->>'complete_depth')::integer=3)
FROM profiles;
t
CREATE INDEX ggc_path_edge_in ON ggc_path_edge(dst);
-- IN statistics must select the destination key's opfamily, not column 2.
CREATE TEMP TABLE ggc_path_in_stats AS
WITH scopes AS
(
 SELECT logical_scope||'{"direction":2}'::jsonb l,
        physical_scope||jsonb_build_object('direction',2,
          'index_relid','ggc_path_edge_in'::regclass::oid::bigint) p,options
 FROM ggc_path_state
)
SELECT pg_graph_statistic_create(l,'{}'::jsonb) logical_oid,
       pg_graph_statistic_create(p,'{}'::jsonb) physical_oid,options
FROM scopes;
WITH collected AS
(
 SELECT pg_graph_statistic_collect_path(logical_oid,physical_oid,options) j
 FROM ggc_path_in_stats
)
SELECT j->>'status'='READY' AND (j->>'published')::boolean
   AND (j->>'complete_depth')::int=4
FROM collected;
t
-- Registered singleton populations must never be consumed as global means.
CREATE FUNCTION pg_temp.anchor_cost(oid,oid,oid,integer,integer,
 bigint,bigint,bigint,bigint,integer,integer,float8,float8[],integer,bigint,boolean,bigint)
RETURNS text AS '$libdir/test_graph_core','test_graph_path_cost'
LANGUAGE C STRICT;
CREATE TEMP TABLE ggc_anchor_state AS
WITH registered AS
(
 SELECT logical_scope||'{"semantic_fingerprint":333}'::jsonb l,
        physical_scope||'{"semantic_fingerprint":333}'::jsonb p,
        options||'{"seed_target":1}'::jsonb options
 FROM ggc_path_state
)
SELECT l,p,options,
 pg_graph_statistic_create(l,'{"anchor_condition":{"version":1,"key":1}}') lo,
 pg_graph_statistic_create(p,'{"anchor_condition":{"version":1,"key":1}}') po
FROM registered;
SELECT j->>'status'='READY' AND (j->>'population')::int=1
 AND (j->>'seed_count')::int=1 AND (j->'stages'->3->>'P')::int=9
FROM ggc_anchor_state s,
 LATERAL (SELECT pg_graph_statistic_collect_path(lo,po,options) j) q;
t
SELECT count(*)>0
 AND bool_and(profile.value->'metadata'->'anchor_condition'='{"version":1,"key":1}'::jsonb)
 AND bool_and(profile.value->'metadata'->>'sample_method'='registered_singleton_fixed_path')
FROM ggc_anchor_state s,
 LATERAL jsonb_array_elements(pg_graph_statistic_read(lo,l)->'profiles') AS profile(value);
t
WITH estimates AS
(
 SELECT pg_temp.anchor_cost((l->>'graph_oid')::oid,(l->>'edge_element_oid')::oid,
 (p->>'index_relid')::oid,77,1,7,11,1,333,4,1,1.0,
 ARRAY[0,0,0,0]::float8[],64,1048576,false,k)::jsonb j,k
 FROM ggc_anchor_state CROSS JOIN (VALUES(1::bigint),(2::bigint)) keys(k)
)
SELECT bool_and(CASE WHEN k=1 THEN
 (j->>'logical_state')::int=1 AND (j->>'physical_state')::int=1
 AND (j->'stages'->2->>'F')::int=1 AND (j->'stages'->2->>'B')::int=3
 AND (j->'stages'->3->>'P')::int=9
 ELSE (j->>'logical_state')::int=0 AND (j->>'physical_state')::int=0 END)
FROM estimates;
t
SELECT (j->>'logical_state')::int=0 AND (j->>'physical_state')::int=0
FROM ggc_anchor_state s, LATERAL
(SELECT test_graph_path_cost((l->>'graph_oid')::oid,(l->>'edge_element_oid')::oid,
 (p->>'index_relid')::oid,77,1,7,11,1,333,4,1,1.0,
 ARRAY[0,0,0,0]::float8[],64,1048576)::jsonb j) q;
t
-- Degree collection is bounded even when one seed has many unique endpoints.
INSERT INTO ggc_path_vertex SELECT i FROM generate_series(1001,101000) i;
INSERT INTO ggc_path_edge
 SELECT 1000000+i,i,1,5,'budget' FROM generate_series(1001,101000) i;
CREATE TEMP TABLE ggc_path_budget_results AS
SELECT label,pg_graph_statistic_collect_path(
 s.logical_oid,s.physical_oid,s.options||jsonb_build_object(
   'seed_target',1,'max_bindings',32,'max_scan_pages',1000000,
   'max_examined_entries',examined_limit,'max_memory_bytes',memory_limit,
   'deadline_ms',60000)) result
FROM ggc_path_state s CROSS JOIN
 (VALUES ('memory',1000000,262144),
         ('seed_only',100008,67108864),
         ('degree_rows',102008,67108864)) budgets(label,examined_limit,memory_limit);
SELECT result->>'status'='PARTIAL'
 AND NOT (result->>'published')::boolean
 AND result->>'reason'='max_memory_bytes'
 AND (result->'resources'->>'examined_entries')::bigint>100008
 AND (result->'resources'->>'examined_entries')::bigint<200008
 AND (result->'resources'->>'peak_bytes')::bigint>262144
 AND (result->'resources'->>'peak_bytes')::bigint<1048576
FROM ggc_path_budget_results WHERE label='memory';
t
-- A row-budget exit must retain the degree table's peak, not its initial size.
SELECT d.result->>'status'='PARTIAL'
 AND NOT (d.result->>'published')::boolean
 AND d.result->>'reason'='max_examined_entries'
 AND (d.result->'resources'->>'examined_entries')::bigint=102008
 AND (d.result->'resources'->>'peak_bytes')::bigint>
     (s.result->'resources'->>'peak_bytes')::bigint
FROM ggc_path_budget_results d,ggc_path_budget_results s
WHERE d.label='degree_rows' AND s.label='seed_only';
t
DROP PROPERTY GRAPH ggc_path_graph;
DROP TABLE ggc_path_edge;
DROP TABLE ggc_path_vertex;
