 ARRAY[10]::bigint[],ARRAY[1]::bigint[],2,2,4,368,1048576,
 false,0,1,false,6,0);
ERROR:  graph batch injected provider error
SELECT (test_graph_batch_cleanup_state()::jsonb->>'active')::int=0;
t
SELECT test_graph_batch('ggc_batch_edge','ggc_batch_out',1,
 ARRAY[10]::bigint[],ARRAY[1]::bigint[],2,2,4,368,1048576,
 false,0,1,false,12,0);
ERROR:  graph batch injected provider error
SELECT (test_graph_batch_cleanup_state()::jsonb->>'active')::int=0;
t
-- Rescan scope is exact; a new instrumentation interval counts only phase 1.
SELECT d->>'row_count',d#>>'{instrumentation,parent_bindings}',
 d#>>'{instrumentation,candidates_received}',d#>>'{instrumentation,rescan_count}',
 (SELECT max((r->>'restore_generation')::bigint) FILTER (WHERE r->>'phase'='0')
  < min((r->>'restore_generation')::bigint) FILTER (WHERE r->>'phase'='1')
  FROM jsonb_array_elements(d->'rows') r)
FROM (SELECT test_graph_batch('ggc_batch_edge','ggc_batch_out',1,
 ARRAY[10,20]::bigint[],ARRAY[1,2]::bigint[],2,2,4,368,1048576,
 false,0,1,false,16,0)::jsonb d) s;
6|2|3|1|t
-- Opposite keys from cached visible tuples match lazy slots, in both directions.
-- Updating dst without an IN index also exercises an OUT HOT redirect.
UPDATE ggc_batch_edge SET dst=21,payload=NULL WHERE id=1;
CREATE INDEX ggc_batch_in ON ggc_batch_edge(dst);
WITH results AS MATERIALIZED (
 SELECT direction,repeated,test_graph_batch('ggc_batch_edge',
  CASE WHEN direction=1 THEN 'ggc_batch_out'::regclass ELSE 'ggc_batch_in'::regclass END,
  direction,CASE WHEN direction=1 THEN
   CASE WHEN repeated THEN ARRAY[10,10,20] ELSE ARRAY[10,20] END
   ELSE CASE WHEN repeated THEN ARRAY[21,21,50] ELSE ARRAY[21,50] END END::bigint[],
  CASE WHEN repeated THEN ARRAY[1,2,3] ELSE ARRAY[1,2] END::bigint[],
  4,16,4,8192,1048576,false,0,1,false,mode,0)::jsonb d
 FROM (VALUES(1),(2)) directions(direction)
 CROSS JOIN (VALUES(true),(false)) flags(repeated)
 CROSS JOIN (VALUES(0),(5),(10),(11),(17),(22)) modes(mode)
)
SELECT count(*)=24,
 bool_and((d->>'row_count')::int=CASE WHEN direction=1
  THEN CASE WHEN repeated THEN 5 ELSE 3 END ELSE CASE WHEN repeated THEN 3 ELSE 2 END END),
 bool_and(NOT EXISTS(SELECT 1 FROM jsonb_array_elements(d->'rows') r
  LEFT JOIN ggc_batch_edge e ON e.id=(r->>'edge_id')::bigint
  WHERE e.id IS NULL OR (r->>'opposite')::bigint IS DISTINCT FROM
   CASE WHEN direction=1 THEN e.dst ELSE e.src END)),
 bool_and((d->>'qual_calls')::int=(d->>'row_count')::int)
FROM results;
t|t|t|t
-- Compact delivery has the same first-row and capacity boundaries.
SELECT (d->>'row_count')::int=8,
 (d->>'first_view_count')::int=1,(d->>'max_view_count')::int=3,
 (d#>>'{instrumentation,first_row_batches}')::int=1
FROM (SELECT test_graph_batch('ggc_batch_edge','ggc_batch_out',1,
 ARRAY[10,10,10,10]::bigint[],ARRAY[1,2,3,4]::bigint[],
 4,8,4,1472,1048576,true,0,1,false,17,0)::jsonb d) s;
t|t|t|t
